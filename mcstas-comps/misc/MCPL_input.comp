* Component: MCPL_input
*
* %I
* Written by: Erik B Knudsen, Gregory S Tucker and Peter Willendrup
* Date: Mar 2016, consolidated with MCPL_input_once Oct 2026
* Origin: DTU Physics / European Spallation Source ERIC
*
* Source-like component that reads neutron state parameters from an mcpl-file.
* %D
* Source-like component that reads neutron state parameters from a binary mcpl-file.
*
* MCPL is short for Monte Carlo Particle List, and is a format for sharing events
* between e.g. MCNP(X), Geant4 and McStas.
*
* The --ncount given on the commandline is overwritten by
* (#neutrons in the file) x repeat_count. With preload=1 (and always on GPU)
* only the neutrons within [Emin, Emax] are counted.
*
* When used with MPI, the file is split between the MPI processes: each process
* reads (and preloads) only its own slice of about (#events in the file) / (#MPI processes),
* so that every event in the file is used once per repetition across the whole run.
* (Before Oct 2026, MCPL_input instead let every process read the whole file and
* smeared all events on the non-master processes.)
*
* repeat_count > 1 replays each process' slice that many times, with the event weight
* divided accordingly. All replays after the first are smeared using v_smear, pos_smear and
* dir_smear (the first pass is too if always_smear is set), so repeat_count > 1 MUST be
* combined with at least one *_smear option; if all are 0, repeat_count is reset to 1.
*
* MCPL_input_once is now the same component, kept under its old name.
*
* Example: MCPL_input(filename=voutput,verbose=1,repeat_count=1,v_smear=0.1,pos_smear=0.001,dir_smear=0.01)
*
* %P
* INPUT PARAMETERS
*
* filename: [str]       Name of neutron mcpl file to read
* verbose: [ ]          Print debugging information for the first 10 neutrons read (on the master process)
* preload: [ ]          Load particles during INITIALIZE. On GPU preload is forced
* polarisationuse: [ ]  If !=0 read polarisation vectors from file
* Emin: [meV]           Lower energy bound. Particles found in the MCPL-file below the limit are skipped
* Emax: [meV]           Upper energy bound. Particles found in the MCPL-file above the limit are skipped
* repeat_count: [1]     Replay the contents of the MCPL file this number of times, dividing the event weights by the same number. MUST be combined with _smear options!
* v_smear: [1]          When replaying events, make a flat MC choice within v_smear*V around particle velocity V
* pos_smear: [m]        When replaying events, make a flat MC choice of position within pos_smear around particle starting position
* dir_smear: [deg]      When replaying events, make an MC choice of direction within dir_smear around particle direction
* always_smear: [ ]     If !=0, also smear the events on their first pass through the file
*
* %E
*******************************************************************************/

DEFINE COMPONENT MCPL_input

SETTING PARAMETERS (string filename=0, polarisationuse=1, verbose=0, Emin=0, Emax=FLT_MAX, int repeat_count=1, v_smear=0, pos_smear=0, dir_smear=0, int preload=0, int always_smear=0)

DEPENDENCY "@MCPLFLAGS@"

SHARE
%{
  #include <mcpl.h>
  #include <stdint.h>
  #include <sys/stat.h>

  #ifndef MCPLINPUT_SHARED
  #define MCPLINPUT_SHARED
  typedef struct {
    // Prefixed names to avoid the _particle accessor macros
    double _x, _y, _z;
    double _vx, _vy, _vz;
    double _sx, _sy, _sz;
    double _t, _p;
  } mcplinput_particle_t;

  /* MCPL units -> McStas units */
  void
  mcplinput_translator (const int use_polarisation, double weight_scale, const mcpl_particle_t* input, mcplinput_particle_t* output) {
    // position in cm -> m
    output->_x = input->position[0] / 100;
    output->_y = input->position[1] / 100;
    output->_z = input->position[2] / 100;
    // ekin in MeV -> meV; then to velocity
    double nrm = sqrt (input->ekin * 1e9 / VS2E);
    output->_vx = input->direction[0] * nrm;
    output->_vy = input->direction[1] * nrm;
    output->_vz = input->direction[2] * nrm;
    // polarisation is a direction, and we might ignore it
    output->_sx = (use_polarisation) ? input->polarisation[0] : 0;
    output->_sy = (use_polarisation) ? input->polarisation[1] : 0;
    output->_sz = (use_polarisation) ? input->polarisation[2] : 0;
    // time in ms -> s
    output->_t = input->time * 1e-3;
    // weight in unspecified units
    output->_p = input->weight * weight_scale;
  }

  void
  mcplinput_print (const char* compname, uint64_t index, const mcpl_particle_t* particle) {
    printf ("%s: id=%llu pdg=%ld\tekin=%g MeV\tx=%g cm\ty=%g cm\tz=%g cm\tux=%g\tuy=%g\tuz=%g\tt=%g ms\tweight=%g\tpolx=%g\tpoly=%g\tpolz=%g\n", compname,
            (unsigned long long)index, (long)particle->pdgcode, particle->ekin, particle->position[0], particle->position[1], particle->position[2],
            particle->direction[0], particle->direction[1], particle->direction[2], particle->time, particle->weight, particle->polarisation[0],
            particle->polarisation[1], particle->polarisation[2]);
  }

  int
  mcplinput_file_exist (char* fn) {
    struct stat buffer;
    return (stat (fn, &buffer) == 0);
  }
  #endif
%}

DECLARE
%{
  mcpl_file_t inputfile;
  uint64_t nparticles;
  uint64_t first_particle;
  uint64_t slice_len;
  uint64_t nevents;
  uint64_t read_neutrons;
  uint64_t used_neutrons;
  uint64_t emitted_neutrons;
  uint64_t current_index;
  uint64_t uid_offset;
  int times_replayed;
  int file_open;
  double weight_factor;
  double weight_scale;
  mcplinput_particle_t* particles;
  char* resolved_filename;
%}

INITIALIZE
%{
  {
    if (!filename || !filename[0]) {
      fprintf (stderr, "ERROR(%s): Requires filename parameter.\n", NAME_CURRENT_COMP);
      exit (-1);
    }
    char* fn_mcpl = mcpl_name_helper (filename, 'M');
    char* fn_mcplgz = mcpl_name_helper (filename, 'G');
    if (mcplinput_file_exist (fn_mcpl)) {
      if (mcplinput_file_exist (fn_mcplgz)) {
        fprintf (stderr,
                 "ERROR(%s): Can not resolve input file unambiguously"
                 " since both %s and %s exist.\n",
                 NAME_CURRENT_COMP, fn_mcpl, fn_mcplgz);
        exit (-1);
      }
      resolved_filename = fn_mcpl;
      free (fn_mcplgz);
    } else {
      resolved_filename = fn_mcplgz;
      free (fn_mcpl);
    }
  }

  if (Emax < Emin) {
    fprintf (stderr, "ERROR(%s): Nonsensical energy interval: E=[%g,%g]. Aborting.\n", NAME_CURRENT_COMP, Emin, Emax);
    exit (-1);
  }

  /* No need to check if the file opens correctly since mcpl will
   * abort internally if it cannot open the file.*/
  inputfile = mcpl_open_file (resolved_filename);
  file_open = 1;
  double mcpl_ray_count = mcpl_hdr_stat_sum (inputfile, "initial_ray_count");
  if (mcpl_ray_count == -2.0) {
    // legacy format without ray count:
    weight_scale = 1.0;
  } else if (!(mcpl_ray_count > 0.0)) {
    fprintf (stderr,
             "ERROR(%s): Input MCPL file has invalid initial_ray_count"
             " (%g). Unable to determine weight scale.\n",
             NAME_CURRENT_COMP, mcpl_ray_count);
    exit (-1);
  } else {
    weight_scale = 1.0 / mcpl_ray_count;
  }

  if (!(nparticles = mcpl_hdr_nparticles (inputfile))) {
    fprintf (stderr, "ERROR(%s): MCPL file (%s) reports no particles. Aborting.\n", NAME_CURRENT_COMP, resolved_filename);
    exit (-1);
  }
  MPI_MASTER (printf ("Message(%s): MCPL file (%s) produced with %s.\n", NAME_CURRENT_COMP, resolved_filename, mcpl_hdr_srcname (inputfile));
              printf ("Message(%s): MCPL file (%s) contains %llu particles.\n", NAME_CURRENT_COMP, resolved_filename, (unsigned long long)nparticles););

  if (repeat_count < 1)
    repeat_count = 1;
  if (repeat_count > 1 && v_smear == 0 && pos_smear == 0 && dir_smear == 0) {
    MPI_MASTER (fprintf (stderr,
                         "WARNING(%s): You have requested repeat_count=%i but have left all *_smear parameters at 0!\n"
                         " --> Replaying identical events is not allowed. Resetting to repeat_count=1!\n",
                         NAME_CURRENT_COMP, repeat_count););
    repeat_count = 1;
  }

  /* This process' slice of the file: [first_particle, first_particle + slice_len) */
  first_particle = 0;
  slice_len = nparticles;
  #if defined (USE_MPI)
  {
    uint64_t particles_per_node = nparticles / mpi_node_count;
    // at least 1 particle per node
    if (particles_per_node < 1)
      particles_per_node = 1;
    first_particle = particles_per_node * mpi_node_rank;
    if (first_particle >= nparticles) {
      // more MPI processes than particles: this process gets nothing
      first_particle = nparticles;
      slice_len = 0;
    } else if (mpi_node_rank == mpi_node_count - 1) {
      // the last process takes the remainder, to cover the full file
      slice_len = nparticles - first_particle;
    } else {
      slice_len = particles_per_node;
    }
  }
  #endif

  read_neutrons = 0;
  used_neutrons = 0;
  emitted_neutrons = 0;
  current_index = 0;
  times_replayed = 0;
  particles = NULL;

  #ifdef OPENACC
  preload = 1;
  MPI_MASTER (printf ("Message(%s): OpenACC, preload implicit.\n", NAME_CURRENT_COMP););
  #endif

  // Move this process' pointer into the file to its first particle
  if (slice_len)
    mcpl_seek (inputfile, first_particle);

  if (preload) {
    MPI_MASTER (printf ("Message(%s): Preload requested, loading MCPL file in INITIALIZE.\n", NAME_CURRENT_COMP););
    if (slice_len) {
      particles = (mcplinput_particle_t*)calloc (slice_len, sizeof (mcplinput_particle_t));
      if (!particles) {
        fprintf (stderr, "ERROR(%s): Could not allocate memory for %llu particles.\n", NAME_CURRENT_COMP, (unsigned long long)slice_len);
        exit (-1);
      }
    }
    for (uint64_t loop = 0; loop < slice_len; loop++) {
      const mcpl_particle_t* particle = mcpl_read (inputfile);
      if (particle && particle->pdgcode == 2112) {
        MPI_MASTER (if (verbose && read_neutrons < 10) mcplinput_print (NAME_CURRENT_COMP, read_neutrons, particle););
        if (particle->ekin > Emin * 1e-9 && particle->ekin < Emax * 1e-9) {
          mcplinput_translator (polarisationuse, weight_scale, particle, particles + used_neutrons++);
        }
        read_neutrons++;
      }
    }
    mcpl_close_file (inputfile);
    file_open = 0;
    // only the kept neutrons are replayed
    nevents = used_neutrons;
  } else {
    // events are read in TRACE, those not passing the filters are ABSORBed
    nevents = slice_len;
  }

  /* Total number of events across all processes */
  uint64_t total_events = nevents;
  #if defined (USE_MPI)
  MPI_Allreduce (&nevents, &total_events, 1, MPI_UINT64_T, MPI_SUM, MPI_COMM_WORLD);
  #endif
  if (total_events == 0) {
    fprintf (stderr, "ERROR(%s): No usable neutrons in MCPL file %s (E=[%g,%g] meV). Aborting.\n", NAME_CURRENT_COMP, resolved_filename, Emin, Emax);
    exit (-1);
  }
  if (preload) {
    MPI_MASTER (printf ("Message(%s): Done reading MCPL file, kept %llu neutrons in total.\n", NAME_CURRENT_COMP, (unsigned long long)total_events););
  }

  uint64_t node_ncount;
  if (!mcdotrace) {
    // the main loop gives each MPI process floor(ncount / #processes) rays
    mcset_ncount (total_events * repeat_count);
    node_ncount = total_events * repeat_count;
    #if defined (USE_MPI)
    node_ncount /= mpi_node_count;
    #endif
    MPI_MASTER (if (repeat_count > 1) printf ("Message(%s): repeat_count=%i, ncount set to %llu x %i = %llu.\n", NAME_CURRENT_COMP, repeat_count,
                                              (unsigned long long)total_events, repeat_count, (unsigned long long)(total_events * repeat_count)););
  } else {
    node_ncount = (uint64_t)mcget_ncount ();
  }

  /* Each of this process' nevents events is emitted node_ncount/nevents times on average
     (= repeat_count without MPI), so its weight is scaled by the inverse */
  weight_factor = (nevents && node_ncount) ? (double)nevents / (double)node_ncount : 1.0;

  /* _uid of this process' first ray, used to find the event when preloaded */
  uid_offset = 0;
  #if defined (USE_MPI)
  uid_offset = (uint64_t)mpi_node_rank * node_ncount;
  #endif
%}

TRACE
%{
  mcplinput_particle_t buffer;
  mcplinput_particle_t* ptr = NULL;
  uint64_t pass = 0;

  if (nevents == 0)
    ABSORB;

  #ifndef OPENACC
  // preload can only be false without OpenACC
  if (!preload) {
    if (current_index >= slice_len) {
      // go back to the start of this process' slice and replay it
      current_index = 0;
      mcpl_seek (inputfile, first_particle);
      times_replayed++;
    }
    const mcpl_particle_t* particle = mcpl_read (inputfile);
    current_index++;
    pass = times_replayed;
    if (!particle || particle->pdgcode != 2112) {
      ABSORB;
    }
    if (!times_replayed) {
      MPI_MASTER (if (verbose && read_neutrons < 10) mcplinput_print (NAME_CURRENT_COMP, read_neutrons, particle););
      read_neutrons++;
    }
    if (particle->ekin < Emin * 1e-9 || particle->ekin > Emax * 1e-9) {
      ABSORB;
    }
    if (!times_replayed)
      used_neutrons++;
    mcplinput_translator (polarisationuse, weight_scale, particle, &buffer);
    ptr = &buffer;
  } else {
    #endif
    uint64_t local_index = (uint64_t)_particle->_uid;
    if (local_index >= uid_offset)
      local_index -= uid_offset;
    pass = local_index / nevents;
    ptr = particles + (local_index % nevents);
    #ifndef OPENACC
  }
  #endif

  #pragma acc atomic
  emitted_neutrons++;

  x = ptr->_x;
  y = ptr->_y;
  z = ptr->_z;
  vx = ptr->_vx;
  vy = ptr->_vy;
  vz = ptr->_vz;
  sx = ptr->_sx;
  sy = ptr->_sy;
  sz = ptr->_sz;
  t = ptr->_t;
  // correct for replaying (repeat_count and/or uneven MPI slices)
  p = ptr->_p * weight_factor;

  if (always_smear || pass > 0) {
    if (pos_smear) {
      double tmpx, tmpy, tmpz;
      randvec_target_circle (&tmpx, &tmpy, &tmpz, NULL, 0, 0, 1, 0);
      NORM (tmpx, tmpy, tmpz);
      x += tmpx * pos_smear * rand01 ();
      y += tmpy * pos_smear * rand01 ();
      z += tmpz * pos_smear * rand01 ();
    }
    if (v_smear) {
      double fraction = 1.0 + v_smear * randpm1 ();
      vx *= fraction;
      vy *= fraction;
      vz *= fraction;
    }
    if (dir_smear) {
      double vv, dx, dy, dz;
      vv = sqrt (vx * vx + vy * vy + vz * vz);
      dx = vx / vv;
      dy = vy / vv;
      dz = vz / vv;
      randvec_target_circle (&dx, &dy, &dz, NULL, dx, dy, dz, sin (dir_smear * DEG2RAD));
      NORM (dx, dy, dz);
      vx = dx * vv;
      vy = dy * vv;
      vz = dz * vv;
    }
  }
  SCATTER;
%}

FINALLY
%{
  #ifndef OPENACC
  if (file_open) {
    mcpl_close_file (inputfile);
    file_open = 0;
  }
  #endif

  uint64_t requested_neutrons = (uint64_t)mcget_ncount ();
  uint64_t events = nevents;
  uint64_t tolerance = 1;
  #if defined (USE_MPI)
  // the main loop rounds the number of rays per process down
  tolerance = mpi_node_count;
  uint64_t accumulated[5], distributed[5];
  distributed[0] = used_neutrons;
  distributed[1] = read_neutrons;
  distributed[2] = emitted_neutrons;
  distributed[3] = requested_neutrons;
  distributed[4] = nevents;
  MPI_Reduce (distributed, accumulated, 5, MPI_UINT64_T, MPI_SUM, 0, MPI_COMM_WORLD);
  if (mpi_node_rank == 0) {
    used_neutrons = accumulated[0];
    read_neutrons = accumulated[1];
    emitted_neutrons = accumulated[2];
    requested_neutrons = accumulated[3];
    events = accumulated[4];
    #endif
    if (used_neutrons != read_neutrons) {
      fprintf (stdout, "Message(%s): You have used %llu of %llu neutrons available in the MCPL file.\n", NAME_CURRENT_COMP, (unsigned long long)used_neutrons,
               (unsigned long long)read_neutrons);
    }
    uint64_t expected = events * (uint64_t)repeat_count;
    if (requested_neutrons + tolerance <= expected || requested_neutrons >= expected + tolerance) {
      fprintf (stderr,
               "Warning(%s): %llu rays were traced, but the MCPL file holds %llu usable events x repeat_count=%i = %llu,\n"
               "so events were %s%s. %llu neutrons were emitted in total. Please examine the recorded intensities carefully.\n",
               NAME_CURRENT_COMP, (unsigned long long)requested_neutrons, (unsigned long long)events, repeat_count, (unsigned long long)expected,
               requested_neutrons > expected ? "replayed" : "left unused",
               (requested_neutrons > expected && v_smear == 0 && pos_smear == 0 && dir_smear == 0) ? " WITHOUT smearing" : "",
               (unsigned long long)emitted_neutrons);
    }
    #if defined (USE_MPI)
  }
  #endif

  if (particles != NULL) {
    free (particles);
    particles = NULL;
  }
  free (resolved_filename);
%}

MCDISPLAY
%{
  multiline (5, 0.2, 0.2, 0.0, -0.2, 0.2, 0.0, -0.2, -0.2, 0.0, 0.2, -0.2, 0.0, 0.2, 0.2, 0.0);
  /*M*/
  multiline (5, -0.085, -0.085, 0.0, -0.085, 0.085, 0.0, -0.045, -0.085, 0.0, -0.005, 0.085, 0.0, -0.005, -0.085, 0.0);
  /*I*/
  line (0.045, -0.085, 0, 0.045, 0.085, 0);
  line (0.005, 0.085, 0, 0.085, 0.085, 0);
  line (0.005, -0.085, 0, 0.085, -0.085, 0);
%}

END
